# Copy to .env.local for local dev, or configure on the server. Keep credentials out of Git.

# Hosted Postgres. For a laptop demo on Node.js 22.13+, set AINPATH_SQLITE_PATH instead.
DATABASE_URL=
DATABASE_URL_POOLED=
# AINPATH_SQLITE_PATH=./ainpath.sqlite

# Optional AI. Cloud processing requires consent. The demo flag permits only untouched fictional inputs.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AINPATH_DEMO_CLOUD=0
# AINPATH_LOCAL_MODEL=your-installed-ollama-model

# Optional local directory containing ben.traineddata.gz and eng.traineddata.gz for offline OCR.
# TESSERACT_LANG_PATH=/absolute/path/to/tessdata

# Optional secret for the retention sweep endpoint.
CRON_SECRET=

# Upload limits
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=12
MAX_FILES=8
