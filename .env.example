# Neon Postgres (required for Vercel + local)
# Prefer the pooled connection string on Vercel serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Optional LLM (Groq). Without it, analysis falls back to rules.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Upload limits
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=12
MAX_FILES=8
