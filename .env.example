# Copy to .env.local for local dev, or set the same names in Vercel.
# Never commit real secrets.

# Neon Postgres (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Groq LLM (recommended for full analysis; without it, rules fallback still works)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Upload limits (optional)
MAX_UPLOAD_MB=8
MAX_PDF_PAGES=12
MAX_FILES=8
